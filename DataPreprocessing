-e245-4762-a004-49b52d5f06cb","cell_type":"code","source":"def fill_nan(x):\n    # Nội suy tuyến tính NaN theo từng lead\n    if not np.isnan(x).any():\n        return x\n    return pd.DataFrame(x).interpolate(limit_direction=\"both\").to_numpy()\n\n\ndef bandpass(x, fs, lo, hi, order=4):\n    # Giữ tần số lo..hi; lọc 2 chiều nên không lệch pha đỉnh QRS\n    sos = butter(order, [lo, hi], btype=\"bandpass\", fs=fs, output=\"sos\")\n    return sosfiltfilt(sos, x, axis=0)\n\n\ndef notch(x, fs, f0):\n    # Chặn đúng 1 tần số (50/60 Hz điện lưới)\n    b, a = iirnotch(f0, Q=30, fs=fs)\n    return filtfilt(b, a, x, axis=0)\n\ndef bandpass_clean(sig, fs, lo=0.5, hi=40, notch_hz=None):\n    \"\"\"fill_nan -> (notch nếu cần) -> bandpass.\"\"\"\n    y = fill_nan(sig)\n    if notch_hz:\n        y = notch(y, fs, notch_hz)\n    return bandpass(y, fs, lo, hi)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"8a241cfb-0985-4579-a620-f9b70cbe5850","cell_type":"code","source":"med = np.median(Ps, axis=0)\ncum = np.cumsum(med) / med.sum()\n\nfor hz in (20, 30, 40, 50, 100):\n    print(f\"<= {hz} Hz: {cum[f <= hz][-1]*100:.2f}% năng lượng\")\n\nplt.plot(f, cum); plt.xlim(0, 100); plt.grid(True)\nplt.axvline(40, c=\"r\", ls=\"--\"); plt.xlabel(\"Hz\"); plt.ylabel(\"Cumulative power\")\nplt.savefig(\"/kaggle/working/cul_energy.png\", dpi=200, bbox_inches=\"tight\")\nplt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"043e0262-2399-4638-9636-59ee04b9720c","cell_type":"code","source":"import numpy as np, matplotlib.pyplot as plt\n\nfig, ax = plt.subplots(figsize=(11, 5.5))\nmed = np.median(Ps, axis=0)\nax.semilogy(f, med, c=\"C0\", lw=2, label=\"Median\")\nax.fill_between(f, np.percentile(Ps, 5, axis=0),\n                   np.percentile(Ps, 95, axis=0), alpha=.25, color=\"C0\", label=\"5-95%\")\n\n# Shaded regions\nax.axvspan(0, 0.5,  color=\"red\",   alpha=.25)\nax.axvspan(0.5, 40, color=\"green\", alpha=.08)\nax.axvspan(40, 100, color=\"gray\",  alpha=.15)\n\n# Cutoff / mains lines\nax.axvline(0.5, c=\"r\", ls=\"--\", lw=1.2)\nax.axvline(40,  c=\"r\", ls=\"--\", lw=1.2)\nax.axvline(50,  c=\"g\", ls=\":\",  lw=1.2)\nax.axvline(60,  c=\"orange\", ls=\":\", lw=1.2)\n\nbox = dict(boxstyle=\"round,pad=0.3\", fc=\"white\", ec=\"none\", alpha=.85)\n\n# Region labels (bottom, in empty space, away from lines)\nax.text(20, 2e-8, \"KEEP: 0.5-40 Hz\\n(P, T, ST, QRS = cardiac signal)\",\n        color=\"green\", ha=\"center\", fontsize=11, weight=\"bold\", bbox=box)\nax.text(70, 2e-8, \"REMOVE: > 40 Hz\\n(muscle + measurement noise)\",\n        color=\"dimgray\", ha=\"center\", fontsize=11, weight=\"bold\", bbox=box)\n\n# Annotations (placed in clear areas, arrows point to the feature)\nax.annotate(\"Baseline wander (< 0.5 Hz)\\n→ removed by high-pass\",\n            xy=(0.3, 1e-5), xytext=(8, 3e-9),\n            arrowprops=dict(arrowstyle=\"->\", color=\"red\"),\n            color=\"red\", ha=\"left\", fontsize=10, bbox=box)\nax.annotate(\"No sharp peak at 50/60 Hz\\n→ notch not needed\",\n            xy=(55, 4e-6), xytext=(78, 2e-3),\n            arrowprops=dict(arrowstyle=\"->\"), ha=\"center\", fontsize=10, bbox=box)\nax.annotate(\"Most ECG energy\\n(P, QRS, T)\",\n            xy=(8, 1e-3), xytext=(22, 2e-2),\n            arrowprops=dict(arrowstyle=\"->\"), ha=\"center\", fontsize=10, bbox=box)\n\n# Line labels at the top\nax.text(0.8, 0.8e-1, \"0.5 Hz\", color=\"r\", fontsize=9, va=\"top\")\nax.text(40.8, 0.8e-1, \"40 Hz\", color=\"r\", fontsize=9, va=\"top\")\nax.text(50.8, 0.8e-1, \"50 Hz\", color=\"g\", fontsize=9, va=\"top\")\nax.text(60.8, 0.8e-1, \"60 Hz\", color=\"orange\", fontsize=9, va=\"top\")\n\nax.set_xlim(0, 100); ax.set_ylim(1e-9, 1e-1)\nax.set_xlabel(\"Frequency (Hz)\"); ax.set_ylabel(\"PSD\")\nax.set_title(\"PTB-XL: median PSD over 300 records (12-lead average)\")\nax.grid(True, alpha=.5); ax.legend(loc=\"upper right\")\n\nplt.savefig(\"/kaggle/working/psd_annotated.png\", dpi=200, bbox_inches=\"tight\")\nplt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"f63233d1-6fa1-44a2-8b1a-2cda0a2487da","cell_type":"code","source":"def lead_std(sig):\n    return np.std(fill_nan(sig), axis=0)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"dc201c50-2ec7-4671-8461-726229d2c0c8","cell_type":"code","source":"ids = df.sample(1000, random_state=1)[\"filename_hr\"].tolist()\nS = np.array([lead_std(read_record(fn).p_signal) for fn in ids])   # (1000, 12)\n\nprint(np.percentile(S, [0, 0.1, 1, 5, 50]))   # mV\nplt.hist(np.log10(S.ravel() + 1e-6), bins=100)\nplt.xlabel(\"log10(std)\"); plt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"8ec1ef03-5778-4a98-b1db-938da816a599","cell_type":"code","source":"def amp(sig_clean):\n    return np.abs(sig_clean).max(axis=0)       # (12,) biên độ lớn nhất mỗi lead\n\nA = []\nfor fn in ids:\n    r = read_record(fn)\n    A.append(amp(bandpass_clean(r.p_signal, r.fs))) \nA = np.array(A)                                     \n\nprint(np.percentile(A, [50, 95, 99, 99.9, 100]))","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"7f317339-11ad-45e1-90bf-12f4d6721b79","cell_type":"code","source":"MAX_NAN_RATIO = 0.10   # quá 10% NaN -> loại\nFLAT_STD = 0.005       # std < 5 uV coi là lead phẳng\nMAX_FLAT_LEADS = 2     # nhiều hơn 2 lead phẳng -> loại\nMAX_ABS_MV = 20.0      # biên độ > 20 mV là bất thường","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"243a95db-d583-49b0-9d57-d289fd43cf40","cell_type":"code","source":"from collections import Counter\nimport numpy as np\n\ndef check_record(sig, fs):\n    nan_ratio = np.isnan(sig).mean()\n    if nan_ratio > MAX_NAN_RATIO:\n        return \"nan\"\n    raw = fill_nan(sig)\n    n_flat = (raw.std(axis=0) < FLAT_STD).sum()\n    if n_flat > MAX_FLAT_LEADS:\n        return \"flat\"\n    y = bandpass(raw, fs, 0.5, 40)\n    if np.abs(y).max() > MAX_ABS_MV:\n        return \"amplitude\"\n    return None\n\nbad = Counter()\nfor fn in ids:\n    r = read_record(fn)\n    bad[check_record(r.p_signal, r.fs)] += 1\nprint(bad, \"/\", len(ids))","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"f1641cb9-71fc-45d1-9b34-abf67a8d99da","cell_type":"code","source":"R = np.array([artifact_ratio(bandpass_clean(read_record(fn).p_signal, 500)) for fn in ids])\nfor q in (95, 98, 99, 99.5):\n    thr = np.percentile(R, q)\n    print(f\"top {100-q:.1f}% -> thr={thr:.1f}, loại {(R > thr).sum()}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"76b210f2-8134-4fc7-b9a1-adc3f75ed6bb","cell_type":"code","source":"order = np.argsort(R)[::-1]          # R giảm dần\nfor k in order[:6]:\n    r = read_record(ids[k])\n    y = bandpass_clean(r.p_signal, r.fs)\n    j = np.abs(y).max(axis=0).argmax()\n    t = np.arange(len(y)) / r.fs\n    plt.figure(figsize=(12, 2.5)); plt.plot(t, y[:, j])\n    plt.title(f\"{ids[k]}  lead {j}  R={R[k]:.0f}\")\n    plt.savefig(\"/kaggle/working/R_waveform.png\", dpi=200, bbox_inches=\"tight\")\n    plt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"90dd540d-9e30-4f75-a7bf-191f1c4d5a46","cell_type":"code","source":"MAX_NAN_RATIO  = 0.10    # quá 10% NaN -> loại\nFLAT_STD       = 0.005   # std < 5 uV coi là lead phẳng\nMAX_FLAT_LEADS = 0       # PTB-XL không có lead phẳng, có 1 lead là loại\nMAX_ABS_MV     = 20.0    # kiểm tra trên tín hiệu đã lọc + cắt biên","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"c5ce2283-d834-4249-b43e-817a08d331b0","cell_type":"code","source":"LEADS = [\"I\", \"II\", \"III\", \"AVR\", \"AVL\", \"AVF\", \"V1\", \"V2\", \"V3\", \"V4\", \"V5\", \"V6\"]\nPATIENT = df.set_index(\"filename_hr\")[\"patient_id\"]","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"d628ab79-8ad6-4caa-b9fa-fedb0a750be4","cell_type":"code","source":"from collections import Counter\nimport numpy as np\n\ndef check_record(sig, fs):\n    nan_ratio = np.isnan(sig).mean()\n    if nan_ratio > MAX_NAN_RATIO:\n        return \"nan\"\n    raw = fill_nan(sig)\n    n_flat = (raw.std(axis=0) < FLAT_STD).sum()\n    if n_flat > MAX_FLAT_LEADS:\n        return \"flat\"\n    y = bandpass(raw, fs, 0.5, 40)\n    if np.abs(y).max() > MAX_ABS_MV:\n        return \"amplitude\"\n    return None\n\nbad = Counter()\nfor fn in ids:\n    r = read_record(fn)\n    bad[check_record(r.p_signal, r.fs)] += 1\nprint(bad, \"/\", len(ids))","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"c6f1aaf6-32de-4bc3-b322-6d6c85445379","cell_type":"code","source":"def process(rec, out_dir, fs_out=250, lo=0.5, hi=40.0, notch_hz=0, trim_sec=TRIM_SEC):\n    study_id = rec.split(\"/\")[-1].split(\"_\")[0]          # '00001_hr' -> '00001'\n    pid = PATIENT.get(rec, np.nan)\n    row = {\"study_id\": study_id,\n           \"subject_id\": \"\" if pd.isna(pid) else str(int(pid)),\n           \"status\": \"ok\", \"reason\": \"\"}\n    try:\n        r = read_record(rec)\n\n        # 1) Sắp xếp lead theo tên\n        idx = [r.sig_name.index(l) for l in LEADS]\n        x = r.p_signal[:, idx].astype(np.float64)\n        fs = float(r.fs)\n        row.update(fs=fs, n_samples_raw=x.shape[0])\n\n        # 2) Kiểm tra trên tín hiệu thô: NaN, lead phẳng\n        nan_ratio = float(np.isnan(x).mean())\n        row[\"nan_ratio\"] = nan_ratio\n        if nan_ratio > MAX_NAN_RATIO:\n            raise ValueError(f\"nan_ratio={nan_ratio:.2f}\")\n        x = fill_nan(x)\n        n_flat = int((x.std(axis=0) < FLAT_STD).sum())\n        row[\"n_flat_leads\"] = n_flat\n        if n_flat > MAX_FLAT_LEADS:\n            raise ValueError(f\"{n_flat} lead phẳng\")\n\n        # 3) Lọc trên đủ 10 s (lọc trước, cắt sau)\n        x = bandpass(x, fs, lo, hi)\n        if notch_hz:\n            x = notch(x, fs, notch_hz)\n\n        # 5) Biên độ: kiểm tra trên tín hiệu đã lọc + cắt\n        max_abs = float(np.abs(x).max())\n        row[\"max_abs_mv\"] = max_abs\n        if max_abs > MAX_ABS_MV:\n            raise ValueError(f\"biên độ {max_abs:.1f} mV\")\n\n        # 6) Resample\n        if fs_out and int(fs_out) != int(fs):\n            g = math.gcd(int(fs_out), int(fs))\n            x = resample_poly(x, int(fs_out) // g, int(fs) // g, axis=0)\n            row[\"fs_out\"] = fs_out\n\n        row[\"n_samples\"] = x.shape[0]\n        np.save(Path(out_dir) / f\"{study_id}.npy\", x.astype(np.float32))\n    except Exception as e:\n        row[\"status\"] = \"rejected\"\n        row[\"reason\"] = f\"{type(e).__name__}: {e}\"\n    return row","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"ccd6e1aa-5b96-45f1-add7-356e2edbe35a","cell_type":"code","source":"def run_batch(records, out_dir, workers=4, **kw):\n    # Chạy nhiều record song song. Record nào đã có .npy thì bỏ qua,\n    # nên bị ngắt giữa chừng chạy lại cùng lệnh là tiếp tục.\n    out_dir = Path(out_dir)\n    out_dir.mkdir(parents=True, exist_ok=True)\n    todo = [r for r in records if not (out_dir / f\"{r.split('/')[-1]}.npy\").exists()]\n    print(f\"{len(todo)} cần xử lý, {len(records) - len(todo)} đã xong\")\n\n    rows, t0 = [], time.time()\n    with ThreadPoolExecutor(workers) as ex:\n        futs = [ex.submit(process, r, out_dir, **kw) for r in todo]\n        for i, f in enumerate(as_completed(futs), 1):\n            rows.append(f.result())\n            if i % 100 == 0:\n                print(f\"{i}/{len(todo)}  {time.time() - t0:.0f}s\")\n\n    meta = pd.DataFrame(rows)\n    path = out_dir / \"metadata.csv\"\n    if path.exists():\n        old = pd.read_csv(path, dtype={\"study_id\": str, \"subject_id\": str})\n        meta = pd.concat([old, meta], ignore_index=True)\n    if not meta.empty:\n        meta = meta.drop_duplicates(subset=\"study_id\", keep=\"last\").reset_index(drop=True)\n    meta.to_csv(path, index=False)\n    return meta","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"2dab2aea-8e8d-4a9e-9b61-6848f627df33","cell_type":"code","source":"recs = df[\"filename_hr\"].iloc[:200].tolist()\nmeta = run_batch(recs, \"/kaggle/working/ptbxl_clean\", workers=4)\nprint(meta[\"status\"].value_counts())\ncols = [c for c in [\"study_id\", \"status\", \"fs\", \"nan_ratio\", \"n_flat_leads\", \"max_abs_mv\"] if c in meta.columns]\nmeta[cols]","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"40a79843-bdc9-49ca-b19a-493cd083bba2","cell_type":"code","source":"def plot_overlay(rec, fs_out=250, seconds=(0, 4), lo=0.5, hi=40.0):\n    r = read_record(rec)\n    fs = int(r.fs)\n    idx = [r.sig_name.index(l) for l in LEADS]\n    raw = fill_nan(r.p_signal[:, idx].astype(np.float64))\n    clean = bandpass(raw, fs, lo, hi)          # lọc trực tiếp, không qua .npy\n\n    a, b = int(seconds[0] * fs), int(seconds[1] * fs)\n    t = np.arange(a, b) / fs\n\n    fig, axs = plt.subplots(4, 3, figsize=(16, 10), sharex=True)\n    for k, ld in enumerate(LEADS):\n        ax = axs[k % 4, k // 4]\n        ax.plot(t, raw[a:b, k], c=\"gray\", lw=1, alpha=.8, label=\"Raw\")\n        ax.plot(t, clean[a:b, k], c=\"crimson\", lw=1, label=\"Cleaned\")\n        ax.set_title(ld, fontsize=9); ax.grid(True, alpha=.3)\n    axs[0, 0].legend(loc=\"upper right\", fontsize=8)\n    plt.tight_layout(); plt.show()\n\nplot_overlay(rec)","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}